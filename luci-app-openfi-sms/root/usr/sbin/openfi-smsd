#!/bin/sh
#
# openfi-smsd —— 后台定时读一次 SIM，把解码好的 JSON 缓存到文件。
#
# 为什么要有它：
#   前端要"看着的时候刷得快"，但每刷一次都去读 SIM 就要抢串口
#   （信号采样、模组信息页都在用同一根 ttyUSB3）。
#   所以把"读 SIM"收敛到这一个守护进程里：
#     守护进程每 refresh 秒读一次 → 原子写缓存
#     页面每 poll 秒读一次【缓存文件】→ 纯文件读，不碰串口
#   打开页面瞬间就有数据，看着的时候也能刷得很快，而串口占用没变。
#
# 缓存里带一个 ts（epoch 秒）：这块板子的 busybox 【没有 stat】，
# 靠 mtime 判新鲜度不可靠（以前在这上面踩过坑），所以把时间写进文件里。
#
[ -n "${OPENFI_SMS_CACHE:-}" ] || OPENFI_SMS_CACHE=/var/run/openfi-sms.json
[ -n "${OPENFI_SMS_LIB:-}" ] || OPENFI_SMS_LIB=/usr/lib/openfi-sms
[ -n "${OPENFI_SMS_AT:-}" ] || OPENFI_SMS_AT=/usr/lib/openfi-modem/at.sh
[ -n "${OPENFI_SMS_RUNDIR:-}" ] || OPENFI_SMS_RUNDIR=/var/run

INTERVAL=30

# shellcheck source=/dev/null
. "$OPENFI_SMS_AT"

# 原子替换：先写同目录的临时文件再 mv，避免页面读到写了一半的 JSON
cache_write() {
	local tmp="${OPENFI_SMS_CACHE}.tmp.$$"
	printf '%s\n' "$1" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
	mv "$tmp" "$OPENFI_SMS_CACHE" 2>/dev/null
}

read_interval() {
	local v
	v="$(uci -q get openfi_sms.sms.refresh 2>/dev/null)"
	case "$v" in ''|*[!0-9]*) v=30 ;; esac
	[ "$v" -lt 5 ] && v=5
	[ "$v" -gt 3600 ] && v=3600
	INTERVAL="$v"
}

do_round() {
	local raw out tf

	read_interval

	if ! omod_open; then
		# AT 打不开（模组在重启 / 端口没就绪）：保留旧缓存，别让页面突然变空
		logger -t openfi-smsd "AT 打不开: ${AT_ERR:-?}（保留旧缓存）"
		return 0
	fi

	raw="$(omod_query 'AT+CMGL=4')"
	omod_close

	tf="$OPENFI_SMS_RUNDIR/openfi-sms-raw.$$"
	printf '%s\n' "$raw" > "$tf"
	out="$(ucode -L "$OPENFI_SMS_LIB" "$OPENFI_SMS_LIB/decode.uc" "$tf" 2>/dev/null)"
	rm -f "$tf"

	case "$out" in
		'{'*)
			# 把 ts 塞进 JSON 最前面：{"ts":<epoch>, <原来的内容去掉左花括号>
			cache_write "{\"ts\":$(date +%s),$(printf '%s' "$out" | sed 's/^{//')"
			;;
		*)
			logger -t openfi-smsd "解码失败，保留旧缓存"
			;;
	esac
	return 0
}

case "${1:-daemon}" in
daemon)
	while :; do
		do_round
		sleep "$INTERVAL"
	done
	;;
once)
	do_round
	;;
--library) : ;;
*)
	echo "用法: openfi-smsd {daemon|once}" >&2
	exit 1
	;;
esac
