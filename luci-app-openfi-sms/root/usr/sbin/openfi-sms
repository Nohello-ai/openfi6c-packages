#!/bin/sh
#
# openfi-sms —— OpenFi 6C 短信后端
#
#   openfi-sms list              列出 SIM 上的短信（JSON）
#   openfi-sms mark <idx>        把某条标记为已读（AT+CMGR 的副作用）
#   openfi-sms delete <idx>      从 SIM 删除某条
#   openfi-sms sent              本地发件箱（自己发出去的，SIM 上不留）
#   openfi-sms send <号码> <内容> 发送（PDU 编码，成功后追加进本地发件箱）
#
# AT 那套（端口探测、收发、**串口互斥锁**）全部复用 luci-app-openfi-modem
# 的 /usr/lib/openfi-modem/at.sh —— 两个包共用同一把锁，
# 否则你在短信页刷新时，模组信息页正好也在查，两条指令会互相插话。
#
# 为什么要读一次 SIM 就够：SIM 卡能存 50 条，短信本来就在卡上，
# 不需要本地再存一份镜像。只有「发件箱」要本地存 —— 因为发出去的短信
# 模组不一定保留。已读/未读直接用 SIM 上的状态位。

[ -n "${OPENFI_SMS_LIB:-}" ] || OPENFI_SMS_LIB=/usr/lib/openfi-sms
[ -n "${OPENFI_SMS_AT:-}" ] || OPENFI_SMS_AT=/usr/lib/openfi-modem/at.sh
SENT_FILE="${OPENFI_SMS_SENT:-/etc/openfi-sms/sent.json}"
RUNDIR="${OPENFI_SMS_RUNDIR:-/var/run}"

# shellcheck source=/dev/null
. "$OPENFI_SMS_AT"

json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\n\r'
}

# 一行 JSON 错误（前端统一按 {"error": "..."} 处理）
json_err() {
	printf '{"error":"%s"}\n' "$(json_escape "$1")"
	exit 0
}

# 把 AT 的原始输出交给 ucode 解码成 JSON
#   $1 = AT 原始文本
decode_raw() {
	local tmp out
	tmp="$RUNDIR/openfi-sms-raw.$$"
	: > "$tmp" || json_err tmp_failed
	printf '%s\n' "$1" > "$tmp"

	out="$(ucode -L "$OPENFI_SMS_LIB" "$OPENFI_SMS_LIB/decode.uc" "$tmp" 2>&1)"
	rm -f "$tmp"

	case "$out" in
		'{'*) printf '%s\n' "$out" ;;
		*) json_err "decode_failed: $(printf '%s' "$out" | head -c 120)" ;;
	esac
}

# ------------------------------------------------------------------ list
do_list() {
	local raw
	omod_open || json_err "${AT_ERR:-open_failed}"
	raw="$(omod_query 'AT+CMGL=4')"
	omod_close

	decode_raw "$raw"
}

# ------------------------------------------------------------------ mark
# AT+CMGR 会把该条在 SIM 上的状态置为「已读」，这就是我们要的副作用。
# 内容前端已经有了（list 里带来了完整正文），这里不重复解析。
do_mark() {
	local idx="$1"
	[ -n "$idx" ] || json_err "missing_index"
	case "$idx" in *[!0-9]*) json_err "bad_index" ;; esac

	omod_open || json_err "${AT_ERR:-open_failed}"
	omod_query "AT+CMGR=$idx" >/dev/null 2>&1
	omod_close
	printf '{"ok":true,"idx":%s}\n' "$idx"
}

# ------------------------------------------------------------------ delete
do_delete() {
	local idx="$1"
	[ -n "$idx" ] || json_err "missing_index"
	case "$idx" in *[!0-9]*) json_err "bad_index" ;; esac

	omod_open || json_err "${AT_ERR:-open_failed}"
	omod_query "AT+CMGD=$idx" >/dev/null 2>&1
	omod_close
	printf '{"ok":true,"idx":%s}\n' "$idx"
}

# ------------------------------------------------------------------ sent
# $SENT_FILE 是 JSONL：一行一条记录（见 do_send）。这里把它拼成前端要的
# {"messages":[...],"error":""} —— 对外结构不变；文件不存在/为空时是空数组，
# 页面按「还没发过短信」显示，不是错误。
do_sent() {
	local line body

	if [ ! -f "$SENT_FILE" ]; then
		printf '{"messages":[],"error":""}\n'
		return
	fi

	body=''
	while IFS= read -r line || [ -n "$line" ]; do
		line="$(printf '%s' "$line" | tr -d '\r')"
		# 去掉行首/行尾空白（手改过的文件也不至于把 JSON 带崩）
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%"${line##*[![:space:]]}"}"
		# 只收「一个完整 JSON 对象」；坏行跳过，别让整次请求变成非法 JSON
		case "$line" in
			'{'*'}') body="${body:+$body,}$line" ;;
			*)       continue ;;
		esac
	done < "$SENT_FILE"

	printf '{"messages":[%s],"error":""}\n' "$body"
}

# ------------------------------------------------------------------ send
# 需要 PDU 编码（当前模组是 +CMGF:0 PDU 模式）：encode.uc 编出 SMS-SUBMIT，
# 再用 AT+CMGS=<八位组数> 把 PDU 发出去（AT 层是 at.sh 的 omod_send_pdu）。
# 成功之后追加一条记录到 $SENT_FILE —— 发出去的短信模组不一定留在 SIM 上，
# 本地发件箱就是这条链路的落点（见 do_sent）。
do_send() {
	local num="$1" text="$2" tf enc pdu octets resp rc chars now sentdir

	[ -n "$num" ] || json_err "missing_number"
	[ -n "$text" ] || json_err "missing_text"

	# 正文走临时文件：中文/引号/星号都不用操心转义
	tf="$RUNDIR/openfi-sms-text.$$"
	printf '%s' "$text" > "$tf" || json_err tmp_failed

	enc="$(ucode -L "$OPENFI_SMS_LIB" "$OPENFI_SMS_LIB/encode.uc" "$num" "$tf" 2>&1)"
	rm -f "$tf"

	case "$enc" in
		'{'*) : ;;
		*) json_err "encode_failed: $(printf '%s' "$enc" | head -c 120)" ;;
	esac

	pdu="$(printf '%s' "$enc" | sed -n 's/.*"pdu":"\([0-9A-F]*\)".*/\1/p')"
	octets="$(printf '%s' "$enc" | sed -n 's/.*"octets":\([0-9]*\).*/\1/p')"

	[ -n "$pdu" ] || json_err "encode_empty"
	[ -n "$octets" ] || json_err "encode_empty"

	omod_open || json_err "${AT_ERR:-open_failed}"
	resp="$(omod_send_pdu "$octets" "$pdu" 2>&1)"
	rc=$?
	omod_close

	if [ "$rc" -ne 0 ]; then
		json_err "send_failed: $(printf '%s' "$resp" | tr -d '\r' | head -c 160)"
	fi

	chars="$(printf '%s' "$enc" | sed -n 's/.*"chars":\([0-9]*\).*/\1/p')"
	[ -n "$chars" ] || chars=0

	# 记进本地发件箱（SIM 上不一定留）。JSONL：一行一条、只追加，
	# 不用读-改-写，两条短信挨着发也不会互相覆盖。
	now="$(date +%s 2>/dev/null)"
	[ -n "$now" ] || now=0
	sentdir="${SENT_FILE%/*}"
	[ "$sentdir" != "$SENT_FILE" ] || sentdir=.	# 没有目录部分（相对路径）
	mkdir -p "$sentdir" 2>/dev/null
	printf '{"to":"%s","chars":%s,"t":%s}\n' \
		"$(json_escape "$num")" "$chars" "$now" >> "$SENT_FILE" 2>/dev/null

	printf '{"ok":true,"to":"%s","chars":%s}\n' "$(json_escape "$num")" "$chars"
}

# ------------------------------------------------------------------ 入口
case "${1:-list}" in
	list)   do_list ;;
	mark)   do_mark "$2" ;;
	delete) do_delete "$2" ;;
	sent)   do_sent ;;
	send)   do_send "$2" "$3" ;;
	--lib)  : ;;			# 给单元测试 source 用，不执行动作
	*)      json_err "unknown_action" ;;
esac
