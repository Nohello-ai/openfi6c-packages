#!/bin/sh /etc/rc.common
#
# openfi-smsd —— 短信后台缓存守护
#
# START=96：排在网络(20)之后、风扇(98)之前。
# 比信号守护(95)晚一点，避免开机瞬间两个进程同时抢串口。
START=96
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/openfi-smsd daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# 改了刷新间隔：重启守护让它重新读配置。缓存不动，页面不会闪。
	stop
	start
}
