#!/bin/sh
#
# openfi-usbmode —— 开机自动探测模组最佳的 USB 数据模式，并把结果锁下来。
#
# 为什么要有它：
#   模组的 usbnet 模式决定"模组怎么把数据交给 CPU"，速度和结构差别很大：
#       2  MBIM   —— 没有模组内部 NAT，主机直接拿运营商 IP（理论上最好）
#       5  NCM    —— 多包聚合，比 RNDIS 快一档（还是有内部 NAT）
#       3  RNDIS  —— 兼容性最好、速度最差（模组默认）
#   这里开机按 2 → 5 → 3 的顺序逐个试，哪个先真通就用哪个。
#
# 为什么不用 RMNET/QMI：
#   RM500U-CN 是【展锐】平台，RMNET/QMI 是高通那套原生模式，
#   在这颗芯片上基本没实现（社区里有人切 QMI 直接失败）。
#   试它们只会白白多几次 USB 重新枚举。
#
# 安全设计（这块不能出错，错了就没网）：
#   · 最后一定是 RNDIS 兜底 —— 全失败时回到和出厂一样的状态
#   · 只有【真的拿到 IP 并且 ping 得通】才算成功，光是出现网卡不算
#   · 探测结果写进 /etc/openfi-usbmode，以后开机直接用，不再折腾
#   · 每次开机最多切 MAX_TRIES 次，防止来回死循环
#   · 切换前先记下原模式，中途挂了也能回滚
#
# 关掉它：uci set openfi_modem.usbmode.mode='off'
# 钉死某个：uci set openfi_modem.usbmode.mode='5'
#

STATE=/etc/openfi-usbmode
TAG=openfi-usbmode

# 探测顺序：从"理论上最好"到"兼容性最好"
CHAIN="2 5 3"

# 每次开机最多切换几次（防止在几个模式之间来回跳）
MAX_TRIES=6

# 切换后等 USB 重新枚举 + AT 口复活的上限（秒）
REENUM_WAIT=60

# 拉起网络后等地址 + 验连通的上限（秒）
LINK_WAIT=25

log() { logger -t "$TAG" "$*"; }

mode_name() {
	case "$1" in
		0) echo RMNET ;;
		1) echo ECM ;;
		2) echo MBIM ;;
		3) echo RNDIS ;;
		4) echo QMI ;;
		5) echo NCM ;;
		*) echo "未知($1)" ;;
	esac
}

# 每个模式对应哪个内核驱动 —— 用它来找数据网卡，比猜网卡名可靠：
#   RNDIS/ECM → usb0     NCM/MBIM/QMI → wwan0     但这规则会随驱动/内核变
mode_driver() {
	case "$1" in
		2) echo cdc_mbim ;;
		5) echo cdc_ncm ;;
		3) echo rndis_host ;;
		1) echo cdc_ether ;;
		*) echo "" ;;
	esac
}

# MBIM 要用 proto mbim（umbim），其余都是标准 DHCP
mode_proto() {
	case "$1" in
		2) echo mbim ;;
		*) echo dhcp ;;
	esac
}

# 驱动在不在系统里（不在就别浪费一次重新枚举）
driver_present() {
	local d
	d="$(mode_driver "$1")"
	[ -n "$d" ] || return 1
	[ -d "/sys/module/$d" ] && return 0
	find /lib/modules -name "${d}.ko*" 2>/dev/null | grep -q . && return 0
	return 1
}

# MBIM 还需要 umbim 这个用户态工具
tool_present() {
	case "$1" in
		2) command -v umbim >/dev/null 2>&1 ;;
		*) return 0 ;;
	esac
}

# ------------------------------------------------------------------ AT
# 用 mod 包那套（带串口互斥锁），别自己开串口去抢
# shellcheck source=/dev/null
[ -f /usr/lib/openfi-modem/at.sh ] && . /usr/lib/openfi-modem/at.sh

at_get_mode() {
	local r
	omod_open >/dev/null 2>&1 || return 1
	r="$(omod_query 'AT+QCFG="usbnet"')"
	omod_close
	printf '%s' "$r" | sed -n 's/.*"usbnet",\([0-9]*\).*/\1/p' | head -1
}

at_set_mode() {
	local r
	omod_open >/dev/null 2>&1 || return 1
	r="$(omod_query "AT+QCFG=\"usbnet\",$1")"
	omod_close
	case "$r" in *OK*) return 0 ;; *) return 1 ;; esac
}

# 等 AT 口重新活过来：切换 usbnet 之后模组会整个重新枚举，
# 期间 /dev/ttyUSB* 会消失再出现，所以必须等它真能应答 AT 才算数。
wait_at_alive() {
	local i=0 r
	while [ "$i" -lt "$((REENUM_WAIT / 2))" ]; do
		if omod_open >/dev/null 2>&1; then
			r="$(omod_query 'AT')"
			omod_close
			case "$r" in *OK*) return 0 ;; esac
		fi
		sleep 2
		i=$((i + 1))
	done
	return 1
}

# ------------------------------------------------------------------ 网卡
# 按驱动找数据网卡（不猜名字）
find_iface() {
	local want="$1" d ifn drv
	[ -n "$want" ] || return 1
	for d in /sys/class/net/*; do
		ifn="${d##*/}"
		drv="$(basename "$(readlink -f "$d/device/driver" 2>/dev/null)" 2>/dev/null)"
		[ "$drv" = "$want" ] && { echo "$ifn"; return 0; }
	done
	return 1
}

wait_iface() {
	local want="$1" i=0 dev
	while [ "$i" -lt "$((REENUM_WAIT / 2))" ]; do
		dev="$(find_iface "$want")"
		[ -n "$dev" ] && { echo "$dev"; return 0; }
		sleep 2
		i=$((i + 1))
	done
	return 1
}

# ------------------------------------------------------------------ 配置网络
set_wan() {
	local dev="$1" proto="$2"

	uci -q set network.wan.device="$dev"
	uci -q set network.wan.proto="$proto"
	# wan6 跟着走（MBIM/QMI 下 DHCPv6 不一定有，失败也不影响 IPv4）
	uci -q set network.wan6.device="$dev"
	uci -q set network.wan6.proto='dhcpv6'
	uci -q commit network
}

# 真拉起网络并验连通 —— 这一步是关键：
# 网卡出现了不代表能上网（模组没注册/欠费时网卡照样在），必须 ping 通。
verify_link() {
	local dev="$1" i=0

	ifdown wan >/dev/null 2>&1
	sleep 1
	ifup wan >/dev/null 2>&1

	while [ "$i" -lt "$((LINK_WAIT / 2))" ]; do
		if ifstatus wan 2>/dev/null | grep -q '"up": *true'; then
			# ICMP 可能被运营商过滤，所以 DNS 查询也一起试
			if ping -c 2 -W 3 -I "$dev" 223.5.5.5 >/dev/null 2>&1; then
				return 0
			fi
			if nslookup www.baidu.com 223.5.5.5 >/dev/null 2>&1; then
				return 0
			fi
		fi
		sleep 2
		i=$((i + 1))
	done
	return 1
}

# ------------------------------------------------------------------ 状态
state_get() { # $1 = key
	[ -f "$STATE" ] || return 1
	sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -1
}

state_set() { # $1=mode $2=dev $3=proto
	{
		echo "mode=$1"
		echo "dev=$2"
		echo "proto=$3"
		echo "ts=$(date +%s)"
	} > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"
}

apply_state() {
	local mode dev proto
	mode="$(state_get mode)"
	dev="$(state_get dev)"
	proto="$(state_get proto)"

	[ -n "$mode" ] || return 1
	[ -n "$dev" ] || return 1
	[ -d "/sys/class/net/$dev" ] || return 1
	[ -n "$proto" ] || proto="$(mode_proto "$mode")"

	set_wan "$dev" "$proto"
	return 0
}

# ------------------------------------------------------------------ 主流程
main() {
	local cfg cur mode dev proto tries=0 ok=""

	cfg="$(uci -q get openfi_modem.usbmode.mode 2>/dev/null)"
	cfg="${cfg:-auto}"

	if [ "$cfg" = "off" ]; then
		log "配置为 off，不探测，保持现状"
		return 0
	fi

	cur="$(at_get_mode)"
	log "当前模式: ${cur:-未知} $(mode_name "$cur")"

	# 钉死某个模式
	if [ "$cfg" != "auto" ]; then
		case "$cfg" in *[!0-9]*) log "配置值不合法: $cfg"; return 1 ;; esac
		if [ "$cur" = "$cfg" ]; then
			log "已是指定模式 $cfg，只确保 uci 正确"
		else
			log "按配置切到 $cfg"
			at_set_mode "$cfg" || log "切换失败"
			wait_at_alive || log "AT 口没回来"
		fi
		dev="$(wait_iface "$(mode_driver "$cfg")")"
		[ -n "$dev" ] || { log "找不到 $cfg 的网卡"; return 1; }
		set_wan "$dev" "$(mode_proto "$cfg")"
		state_set "$cfg" "$dev" "$(mode_proto "$cfg")"
		return 0
	fi

	# 已经探明过、而且当前就是它 → 直接用，不再折腾（开机快）
	if [ "$(state_get mode)" = "$cur" ] && apply_state; then
		log "沿用上次探明的模式 $cur，跳过探测"
		return 0
	fi

	# 逐个试
	for mode in $CHAIN; do
		[ "$tries" -lt "$MAX_TRIES" ] || { log "切换次数到上限，停止"; break; }
		tries=$((tries + 1))

		if ! driver_present "$mode"; then
			log "跳过 $(mode_name "$mode")：系统里没有 $(mode_driver "$mode") 驱动"
			continue
		fi
		if ! tool_present "$mode"; then
			log "跳过 $(mode_name "$mode")：缺用户态工具"
			continue
		fi

		log "尝试 $(mode_name "$mode")"
		if [ "$cur" != "$mode" ]; then
			at_set_mode "$mode" || { log "$(mode_name "$mode") 切换命令被拒"; continue; }
			wait_at_alive || { log "$(mode_name "$mode") 切换后 AT 口没回来"; continue; }
		fi

		dev="$(wait_iface "$(mode_driver "$mode")")"
		if [ -z "$dev" ]; then
			log "$(mode_name "$mode") 没等到网卡"
			continue
		fi

		proto="$(mode_proto "$mode")"
		set_wan "$dev" "$proto"

		if verify_link "$dev"; then
			log "$(mode_name "$mode") 成功：$dev（proto=$proto）"
			state_set "$mode" "$dev" "$proto"
			ok="$mode"
			break
		fi
		log "$(mode_name "$mode") 网卡拉起来了但连不通，换下一个"
	done

	if [ -z "$ok" ]; then
		log "所有模式都没通，回到 RNDIS 兜底"
		if [ "$(at_get_mode)" != "3" ]; then
			at_set_mode 3
			wait_at_alive
		fi
		dev="$(wait_iface rndis_host)"
		[ -n "$dev" ] || dev="usb0"
		set_wan "$dev" dhcp
		state_set 3 "$dev" dhcp
	fi

	return 0
}

case "${1:-auto}" in
auto) main ;;
show)
	if [ -f "$STATE" ]; then cat "$STATE"; else echo "还没探测过"; fi
	;;
reset) rm -f "$STATE"; echo "已清除探测记录，下次开机会重新探测" ;;
--library) : ;;
*) echo "用法: openfi-usbmode {auto|show|reset}" >&2; exit 1 ;;
esac
