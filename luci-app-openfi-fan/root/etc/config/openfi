config fan 'fan'
	# auto = 按四点温度曲线；manual = 固定转速
	option mode 'auto'
	# 采样周期（秒）
	option period '5'
	# 曲线最低输出（%）。低于它的转速会被抬到该值
	option min_speed '5'
	# manual 模式下的固定转速（%）
	option manual_speed '55'
	# 达到该温度直接全速，不看曲线
	option emergency_temp '85'
	# 1 = 温度低于曲线起点时允许停转；0 = 至少转 min_speed
	option fan_stop '1'
	# 四点曲线（温度 °C / 转速 %），必须递增
	option temp1 '55'
	option temp2 '58'
	option temp3 '61'
	option temp4 '65'
	option speed1 '5'
	option speed2 '36'
	option speed3 '68'
	option speed4 '100'
	# 静默模式（物理开关那一档）下的过热保护：CPU 达到该温度就强制开风扇
	option silent_max_temp '75'
	# 物理开关哪一档算「静默」：1 = 高电平档（出厂默认），0 = 低电平档
	option silent_when_hi '1'

	# ---- 统一温度 ----
	# 参与控温的不是单一 CPU 温度，而是 CPU / WiFi / 5G 模组 三路里**最高的那个**：
	#   CPU   ← /sys/class/thermal/thermal_zone0/temp
	#   WiFi  ← iwpriv ra0 stat 的 CurrentTemperature
	#   模组  ← AT+QTEMP 的 soc-thermal（由 luci-app-openfi-modem 的采样进程提供）
	# 取最高值喂给上面那条四点曲线，等价于「任一路超限就动作」，
	# 所以不需要给每一路单独设阈值。界面上会把三个原始值都显示出来。
	# 想让整体更凉／更静，直接调上面的 temp1~4 / speed1~4 即可。

config led 'led'
	# 灯光总开关：0 = 四盏灯全灭（夜间模式）
	option enabled '1'
	# 每盏灯：on 常亮 / off 常灭 / auto 跟随 WAN 连通性 / keep 不干预
	# internet 默认 auto：通了常亮，不通（或还没测出来）闪烁。
	# 必须这样——usb0 是模组 USB 栈的一部分，没插卡时照样有 IP 和默认路由，
	# 写成 on 的话这盏灯永远是亮的，等于废了。
	option system 'on'
	option internet 'auto'
	option wifi 'on'
	option modem 'on'

config wan 'wan'
	# 连通性探测总开关
	option enabled '1'
	# 探测间隔（秒）
	option interval '10'
	# 连续失败几次判定为不通（10 × 3 = 30 秒）
	option fail_threshold '3'
	# 连续成功几次判定为通
	option ok_threshold '2'
	# 单次探测超时（秒）
	option timeout '2'
	# DNS 查询的目标服务器与域名（主要手段：开销小、很少被整网屏蔽）
	option dns_server '223.5.5.5'
	option dns_host 'www.baidu.com'
	# ICMP 目标（补充手段：部分网络屏蔽 ICMP，所以放在后面）
	option ping_ip '223.5.5.5'
