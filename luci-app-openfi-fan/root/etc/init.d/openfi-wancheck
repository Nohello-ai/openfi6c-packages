#!/bin/sh /etc/rc.common
#
# OpenFi 6C —— WAN 连通性探测服务
#   start/stop/restart 由 procd 管（挂了自动拉起）
#   reload 发 SIGHUP，让守护进程重新读 UCI，探测不中断
#
# 只做探测和写状态，不重启模组、不动 USB 模式。
#
START=97
STOP=11
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/openfi-wancheck
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	local pids

	pids=$(pgrep -f '/usr/sbin/openfi-wancheck$' 2>/dev/null)
	if [ -n "$pids" ]; then
		for p in $pids; do kill -HUP "$p" 2>/dev/null; done
	else
		# 进程不在（异常退出）→ 直接拉起来
		start
	fi

	# 灯可能配了 auto，状态没变也要按新配置重画一次
	/usr/sbin/openfi-led apply >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger openfi
}
