#!/bin/sh
#
# OpenFi 6C 状态灯控制（system / internet / wifi / modem）
#
#   openfi-led apply     按 UCI openfi.led.* 应用
#   openfi-led status    输出一行 JSON（给 LuCI 页面）
#
# 设备树里这四盏灯都是普通 GPIO，且没有 default-trigger ——
# 开机默认全灭，必须由本脚本驱动。
#
# 每盏灯独立设置：
#   on     常亮（trigger=none, brightness=1）
#   off    常灭（trigger=none, brightness=0）
#   auto   跟随 WAN 连通性：通 = 常亮，不通 / 还没测出来 = 闪烁
#   keep   不干预：完全不动它，交回内核或其它程序（例如 /etc/config/system 里的 led 段）
#
# auto 依赖 openfi-wancheck 写的 /var/run/openfi-wan.state。
# 用它的理由：usb0 是模组 USB 栈的一部分，没插卡时照样有 IP 和默认路由，
# 只看接口状态这盏灯永远亮着、等于废了。详见 openfi-wancheck 顶部注释。
#
# 总开关 openfi.led.enabled=0 → 四盏灯全部熄灭（夜间模式）。
#
# 物理开关的「静默模式」也走这里：开关拨到静默档时（运行时标志
# /var/run/openfi-silent 存在），无论 UCI 怎么配，四盏灯一律全灭。
#
LED_NAMES="system internet wifi modem"
LEDROOT=${OPENFI_LEDROOT:-/sys/class/leds}
RUNDIR=${OPENFI_RUNDIR:-/var/run}
WAN_STATE_FILE=${OPENFI_WAN_STATE:-$RUNDIR/openfi-wan.state}

# auto 模式（跟随 WAN 连通性）的闪烁节奏，毫秒
BLINK_ON=${OPENFI_BLINK_ON:-1000}
BLINK_OFF=${OPENFI_BLINK_OFF:-1000}

# 静默模式共用逻辑（缺失时降级为不支持静默；路径可覆盖,便于单元测试）
OPENFI_SILENT_LIB=${OPENFI_SILENT_LIB:-/usr/lib/openfi-fan/silent.sh}
have_silent=0
if [ -r "$OPENFI_SILENT_LIB" ]; then
	. "$OPENFI_SILENT_LIB"
	have_silent=1
fi

num() {
	case "$1" in
		''|*[!0-9-]*) echo null; return ;;
		*) case "$1" in *[0-9]) echo "$1" ;; *) echo null ;; esac ;;
	esac
}

led_cfg() {
	v=$(uci -q get "openfi.led.$1" 2>/dev/null)
	case "$v" in
		on|off|keep|auto) echo "$v" ;;
		*) echo on ;;
	esac
}

# WAN 连通性状态（由 openfi-wancheck 写）：up / down / unknown
wan_state() {
	s=$(cat "$WAN_STATE_FILE" 2>/dev/null | tr -d ' \n')
	case "$s" in
		up|down) echo "$s" ;;
		*) echo unknown ;;
	esac
}

global_enabled() {
	v=$(uci -q get openfi.led.enabled 2>/dev/null)
	case "$v" in
		0) echo 0 ;;
		*) echo 1 ;;
	esac
}

set_one() {
	name=$1
	mode=$2
	p="$LEDROOT/$name"

	[ -d "$p" ] || return 0
	[ -w "$p/brightness" ] || return 1

	case "$mode" in
		on)
			printf 'none\n' > "$p/trigger" 2>/dev/null
			printf '1\n'    > "$p/brightness"
			;;
		off)
			printf 'none\n' > "$p/trigger" 2>/dev/null
			printf '0\n'    > "$p/brightness"
			;;
		auto)
			# 跟随 WAN 连通性：通了常亮，其余（不通/还没测出来）闪烁。
			# 闪烁用内核 timer trigger，不占用户态进程。
			if [ "$(wan_state)" = "up" ]; then
				printf 'none\n' > "$p/trigger" 2>/dev/null
				printf '1\n'    > "$p/brightness"
			else
				printf '%s\n' "$BLINK_OFF" > "$p/delay_off" 2>/dev/null
				printf '%s\n' "$BLINK_ON"  > "$p/delay_on"  2>/dev/null
				printf 'timer\n' > "$p/trigger" 2>/dev/null
			fi
			;;
		keep)
			: ;;
	esac

	return 0
}

do_apply() {
	rc=0

	# 静默模式优先：物理开关拨到静默档 → 不管 UCI 怎么配，四盏灯一律全灭
	if [ "$have_silent" = "1" ] && openfi_silent_active; then
		for n in $LED_NAMES; do
			set_one "$n" off || rc=1
		done
		[ "$rc" -eq 0 ] && logger -t openfi-led "静默模式：四盏灯全灭"
		return "$rc"
	fi

	if [ "$(global_enabled)" = 0 ]; then
		for n in $LED_NAMES; do
			set_one "$n" off || rc=1
		done
		[ "$rc" -eq 0 ] && logger -t openfi-led "灯光总开关关闭：四盏灯全灭"
		return "$rc"
	fi

	for n in $LED_NAMES; do
		set_one "$n" "$(led_cfg "$n")" || rc=1
	done

	return "$rc"
}

do_status() {
	printf '{"enabled":%s,"leds":[' "$(global_enabled)"

	first=1
	for n in $LED_NAMES; do
		p="$LEDROOT/$n"

		[ "$first" -eq 1 ] || printf ','
		first=0

		if [ -d "$p" ]; then
			tr=$(sed -n 's/.*\[\([^]]*\)\].*/\1/p' "$p/trigger" 2>/dev/null)
			br=$(cat "$p/brightness" 2>/dev/null)

			printf '{"name":"%s","exists":true,"trigger":"%s","brightness":%s,"mode":"%s"}' \
				"$n" "${tr:-none}" "$(num "${br:-}")" "$(led_cfg "$n")"
		else
			printf '{"name":"%s","exists":false,"trigger":null,"brightness":null,"mode":"%s"}' \
				"$n" "$(led_cfg "$n")"
		fi
	done

	printf ']}\n'
}

case "${1:-apply}" in
	apply)  do_apply ;;
	status) do_status ;;
	*)      echo "用法: openfi-led {apply|status}" >&2; exit 1 ;;
esac
