{
	"luci-app-openfi-fan": {
		"description": "Grant access to OpenFi 6C fan control (read status, write UCI)",
		"read": {
			"ubus": {
				"file": [
					"exec"
				]
			},
			"file": {
				"/usr/sbin/openfi-fan-status": [
					"exec"
				]
			},
			"uci": [
				"openfi"
			]
		},
		"write": {
			"ubus": {
				"file": [
					"exec"
				]
			},
			"uci": [
				"openfi"
			]
		}
	}
}
